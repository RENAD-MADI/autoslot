@model List<AutoSlotMVC.Models.Booking>

@{
    ViewData["Title"] = "View Bookings";
}

<section>

    <h2>My Bookings</h2>

    @if (Model.Count == 0)
    {
        <p>You have no bookings yet.</p>
    }

    <table border="1">

        <tr>

            <th>ID</th>

            <th>Full Name</th>

            <th>Phone</th>

            <th>Car Serial</th>

            <th>Car Model</th>

            <th>Service</th>

            <th>Date</th>

            <th>Time</th>

            <th>Notes</th>

            <th>Action</th>

        </tr>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.FullName</td>

                <td>@item.Phone</td>

                <td>@item.CarSerial</td>

                <td>@item.CarModel</td>

                <td>@item.ServiceType</td>

                <td>@item.BookingDate.ToShortDateString()</td>

                <td>@item.BookingTime</td>

                <td>@item.Notes</td>

                <td>

                    <form asp-controller="Home" asp-action="DeleteBooking" asp-route-id="@item.Id" method="post"
                          style="display:inline" onsubmit="return confirm('Are you sure?')">
                        <button type="submit">Delete</button>
                    </form>

                    <a asp-controller="Home"
                       asp-action="EditBooking"
                       asp-route-id="@item.Id">

                        Edit

                    </a>

                </td>

            </tr>
        }

    </table>

</section>